# Copie para .env.local na raiz do projeto (não versionar credenciais).

# --- API Nubase / Supabase (obrigatório) ---
# URL https do projeto (com ou sem /rest/v1/ no fim). O servidor admin usa a mesma base que `npm run test:db`.
SUPABASE_API_URL=
SUPABASE_ANON_KEY=
# Chave service role (painel: Project Settings → API). Alias aceito: SUPABASE_SERVICE_ROLE_KEY.
DATABASE_SERVICE_ROLE_KEY=
# Opcional: URL https do mesmo projeto. Se for URI postgres (POSTGRES_URL etc.), deixe vazio aqui — não misture com Postgres.
DATABASE_URL=

# --- Postgres direto (opcional; para `npm run test:db:crud` — CREATE/INSERT/UPDATE/DELETE/DROP) ---
# URI do painel: Settings → Database → Connection string → URI (Session ou Direct).
# POSTGRES_URL=postgresql://postgres.[ref]:[SENHA]@aws-0-....pooler.supabase.com:6543/postgres
# Ou use SUPABASE_DB_HOST, SUPABASE_DB_PORT, SUPABASE_DB_NAME, SUPABASE_DB_USER, SUPABASE_DB_PASSWORD, SUPABASE_DB_SSLMODE

# --- Primeiro usuário admin (POST /api/setup) ---
# Em produção (NODE_ENV=production) é obrigatório definir SETUP_ADMIN_PASSWORD.
SETUP_ADMIN_EMAIL=admin@ferragem.com
SETUP_ADMIN_PASSWORD=
# Token para proteger /api/setup (obrigatório em produção recomendável também em dev).
SETUP_API_TOKEN=
# Opcional: se quiser usar o botão "Configurar Primeiro Acesso" via front-end,
# defina também a versão pública do token abaixo.
NEXT_PUBLIC_SETUP_API_TOKEN=

# --- Twilio (POST /api/seed-twilio grava em company_settings a partir destas variáveis) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_CONTENT_SID=
WHATSAPP_NOTIFICATIONS_ENABLED=true
# Opcional: destino explícito para npm run test:twilio (ex.: seu celular com +55)
# TWILIO_TEST_TO=whatsapp:+5511999999999

# --- Referência (o app lê empresa/WhatsApp principalmente em company_settings no banco) ---
COMPANY_NAME=
ORDER_EMAIL=
WHATSAPP_COUNTRY_CODE=+55
WHATSAPP_NUMBER=

# --- SMTP (opcional; persistido via painel admin) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM_NAME=
SMTP_FROM_EMAIL=
EMAIL_NOTIFICATIONS_ENABLED=true
