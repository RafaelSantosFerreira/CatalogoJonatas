{
  "name": "nextjs-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bash scripts/run-next-dev.sh dev --hostname 127.0.0.1",
    "dev:turbo": "bash scripts/run-next-dev.sh dev --turbopack --hostname 127.0.0.1",
    "dev:debug": "NODE_OPTIONS='--inspect' bash scripts/run-next-dev.sh dev --hostname 127.0.0.1",
    "dev:lan": "bash scripts/run-next-dev.sh dev --hostname 0.0.0.0",
    "dev:poll": "WATCHPACK_POLLING=1 bash scripts/run-next-dev.sh dev --hostname 127.0.0.1",
    "dev:clean": "rm -rf .next-dev && npm run dev",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "next lint",
    "test:db": "node scripts/test-db-connection.mjs",
    "test:db:crud": "node scripts/test-supabase-crud.mjs",
    "test:twilio": "node scripts/test-twilio-whatsapp.mjs",
    "db:migrate": "npx drizzle-kit migrate",
    "db:seed": "npx tsx src/db/seed.ts",
    "db:generate": "npx drizzle-kit generate"
  },
  "dependencies": {
